# ============================================
# Disponibilidade de Salas - Variáveis de Ambiente
# Copie para .env e preencha com seus dados
# ============================================

# App
APP_NAME="Disponibilidade de Salas - UFRRJ"
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=troque-esta-chave-super-secreta-123456789
BASE_URL=http://localhost:8000

# Database - SQLite (dev) / PostgreSQL (prod)
DATABASE_URL=sqlite:///./database.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/salas_db

# OAuth - Google (@ufrrj.br apenas)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Session / JWT
SESSION_SECRET_KEY=outra-chave-super-secreta
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS (frontend)
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Scraper
HORARIO_HTML_PATH=./horario/administrativo.html
